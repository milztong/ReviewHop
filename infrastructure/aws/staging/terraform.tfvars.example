aws_region        = "eu-central-1"
owner             = "REPLACE_OWNER"
image_tag         = "REPLACE_WITH_GIT_COMMIT_SHA"
domain_name       = "staging.ankileet.example"
hosted_zone_id    = "REPLACE_ROUTE53_ZONE_ID"
alert_email       = "REPLACE_EMAIL"
monthly_budget_usd = 50

# Staging favors a cheap, recoverable teardown. Change these only deliberately.
database_deletion_protection = false
database_skip_final_snapshot = true
