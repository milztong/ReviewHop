DOMAIN=demo.ankileet.example
KEYCLOAK_DOMAIN=auth.demo.ankileet.example
KEYCLOAK_ADMIN_DOMAIN=auth-admin.demo.ankileet.example
KEYCLOAK_ADMIN_ALLOWED_CIDRS=192.0.2.10/32
APPLICATION_NETWORK_SUBNET=172.30.0.0/24
CADDY_INTERNAL_IP=172.30.0.10
KEYCLOAK_REALM_FILE=../keycloak/realm-ankileet.json
KEYCLOAK_MEMORY_LIMIT=1536m
POSTGRES_DB=ankileet
POSTGRES_USER=ankileet_migrator
POSTGRES_PASSWORD=replace-with-a-long-random-migrator-secret
ANKILEET_APP_DB_USERNAME=ankileet_app
ANKILEET_APP_DB_PASSWORD=replace-with-a-different-long-random-app-secret
KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-a-different-long-random-keycloak-db-secret
BACKUP_DB_USERNAME=ankileet_backup
BACKUP_DB_PASSWORD=replace-with-a-different-long-random-read-only-backup-secret
KEYCLOAK_ADMIN_USERNAME=replace-with-a-non-obvious-admin-name
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-keycloak-admin-secret
ANKILEET_WEB_CLIENT_SECRET=replace-with-a-long-random-oidc-client-secret
AUTH_SECRET=replace-with-at-least-32-random-bytes
ANKILEET_RATE_LIMIT_READ_REQUESTS=300
ANKILEET_RATE_LIMIT_WRITE_REQUESTS=60
ANKILEET_RATE_LIMIT_WINDOW=PT1M
ANKILEET_RATE_LIMIT_MAX_IDENTITIES=10000
BACKEND_IMAGE=ghcr.io/replace-owner/reviewhop-backend:replace-sha
FRONTEND_IMAGE=ghcr.io/replace-owner/reviewhop-frontend:replace-sha
KEYCLOAK_IMAGE=ghcr.io/replace-owner/reviewhop-keycloak:replace-sha
BACKUP_IMAGE=ghcr.io/replace-owner/reviewhop-backup:replace-sha
# Encrypted Restic repository. Production default after explicit cost approval:
# s3:https://fsn1.your-objectstorage.com/replace-bucket/ankileet/demo
RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/replace-bucket/ankileet/demo
BACKUP_HOST=ankileet-demo
# Secret files are created outside Git with mode 0600; paths are relative to this directory.
BACKUP_DB_PASSWORD_FILE=./secrets/backup-db-password
RESTIC_PASSWORD_FILE=./secrets/restic-repository-password
BACKUP_S3_ACCESS_KEY_FILE=./secrets/backup-s3-access-key
BACKUP_S3_SECRET_KEY_FILE=./secrets/backup-s3-secret-key
RESTORE_VERIFICATION_PASSWORD_FILE=./secrets/restore-verification-password
GRAFANA_ADMIN_USER=ankileet-admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-grafana-admin-secret
GRAFANA_PORT=3001
