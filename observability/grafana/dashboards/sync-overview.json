{
  "annotations": { "list": [] },
  "editable": false,
  "panels": [
    {
      "type": "stat",
      "title": "Sync outcomes (24h)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (outcome) (increase(ankileet_worker_deliveries_total[24h]))", "legendFormat": "{{outcome}}" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Provider requests",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (operation, outcome) (rate(ankileet_provider_requests_total[5m]))", "legendFormat": "{{operation}} / {{outcome}}" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }
    },
    {
      "type": "logs",
      "title": "Correlated sync logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{ "expr": "{job=\"ankileet\"} | json | message =~ `provider_sync_.*`" }],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }
    }
  ],
  "schemaVersion": 41,
  "tags": ["ankileet", "sync"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "title": "ReviewHop Sync Overview",
  "uid": "ankileet-sync",
  "version": 1
}
