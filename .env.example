# Local Docker Compose defaults. Copy to .env only when overriding values.
POSTGRES_DB=ankileet
POSTGRES_USER=ankileet_migrator
POSTGRES_PASSWORD=generate-a-local-migrator-password
ANKILEET_APP_DB_USERNAME=ankileet_app
ANKILEET_APP_DB_PASSWORD=generate-a-different-local-app-password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=generate-a-local-admin-password
ANKILEET_WEB_CLIENT_SECRET=generate-a-local-oidc-client-secret
AUTH_SECRET=generate-at-least-32-random-bytes
GRAFANA_ADMIN_USER=ankileet-admin
GRAFANA_ADMIN_PASSWORD=generate-a-local-grafana-admin-password
GRAFANA_PORT=3001
ANKILEET_TELEMETRY_EXPORT_ENABLED=false
